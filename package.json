  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.ts",
    "shots": "playwright test --config scripts/playwright.config.ts",
    "db:generate": "drizzle-kit generate",
