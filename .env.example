# Copy to .env for local development (or run `vercel env pull .env`); set the same keys in
# Vercel for production. .env is git-ignored. Never commit real values. See SETUP.md.

# --- Leads database (Neon Postgres) ------------------------------------------
# Set automatically by the Vercel Neon integration. Needed locally for db:migrate,
# leads:export and pdf:upload.
DATABASE_URL=

# --- Booking (Cal.id) --------------------------------------------------------
# Every "Book a demo" button opens this. Read at build time: redeploy after changing it.
NEXT_PUBLIC_BOOKING_URL=https://cal.id/priyadharshan-aegisz

# --- Email (Resend) ----------------------------------------------------------
# API key from https://resend.com/api-keys (Sending access is enough).
RESEND_API_KEY=
# Where lead notifications are delivered (you).
CONTACT_TO_EMAIL=
# Sender address on your verified Resend domain, e.g. noreply@aegisz.in
CONTACT_FROM_EMAIL=noreply@aegisz.in

# --- Cloudflare Turnstile (spam protection) ----------------------------------
# From https://dash.cloudflare.com -> Turnstile. If the secret is empty, the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secrets ------------------------------------------------------------------
# Signs the 7-day IAAC overview links. Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_SECRET=
# Hashes visitor IPs before they're stored. Optional: falls back to DOWNLOAD_SECRET.
IP_HASH_SECRET=

# --- Links in emails ----------------------------------------------------------
# Base URL for the download link in emails. Optional: production defaults to
# https://aegisz.in and previews use their own Vercel URL.
SITE_URL=
