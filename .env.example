# Copy to .env.local for local development; set the same keys in Vercel for production.
# Never commit real values. See SETUP.md.

# --- Email (Resend) ---------------------------------------------------------
# API key from https://resend.com/api-keys (Sending access is enough).
RESEND_API_KEY=
# Where form submissions are delivered (you).
CONTACT_TO_EMAIL=
# Sender address on your verified Resend domain, e.g. noreply@aegisz.in
CONTACT_FROM_EMAIL=noreply@aegisz.in

# --- Cloudflare Turnstile (spam protection) ---------------------------------
# From https://dash.cloudflare.com -> Turnstile. If the secret is empty, the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- IAAC overview download -------------------------------------------------
# true (default): name / work email / company form, then a 10-minute signed link.
# false: plain download button, no form. Changing this needs a redeploy.
GATED_DOWNLOAD=true
# Long random string used to sign download links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_SECRET=
